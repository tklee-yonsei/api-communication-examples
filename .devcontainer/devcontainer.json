{
    "name": "API Communication Examples",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "UV_SYSTEM_PYTHON": "1",
        "UV_COMPILE_BYTECODE": "1",
        "UV_PYTHON_DOWNLOADS": "never"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-python.mypy-type-checker",
                "formulahendry.code-runner",
                "DavidAnson.vscode-markdownlint",
                "yzhang.markdown-all-in-one",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "zxh404.vscode-proto3"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": false
                },
                "code-runner.runInTerminal": true,
                "code-runner.saveFileBeforeRun": true,
                "code-runner.executorMap": {
                    "python": "python3 -u"
                },
                "protoc": {
                    "options": [
                        "--proto_path=${workspaceRoot}/grpc_api/protos"
                    ]
                }
            }
        }
    },
    "remoteUser": "root",
    "postCreateCommand": "uv pip install --system -r pyproject.toml && uv pip install --system black pylint pytest pytest-asyncio && python grpc_api/compile_proto.py && echo '개발 환경 준비 완료! docker-compose로 테스트 환경을 실행하세요.'"
}